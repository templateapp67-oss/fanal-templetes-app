# ============================================================================
# Nexora Salon OS — Environment Variables
# ============================================================================

# --- Gemini AI -------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase (used by the client) -----------------------------------------
# These are safe to expose in the browser (Supabase anon key).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# IMPORTANT: if SUPABASE_URL (or VITE_SUPABASE_URL) is set, a key MUST be set
# too. An empty key used to crash the API at startup ("supabaseKey is required"),
# which made EVERY /api/* call answer with an un-parseable HTTP 500 — the
# "We couldn't save your booking (Server error (HTTP 500))" checkout error.
# The client now degrades instead of crashing, and `GET /api/health` reports it.

# --- Supabase (server-side only) -------------------------------------------
# Do NOT expose the service role key to the browser.
# Used by server.ts (Express) and by Supabase Edge Functions.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Server-only: fallback owner (auth user id) used when a booking is created
# by an anonymous guest and the salon's owner id can't be resolved.
SUPABASE_DEMO_OWNER_ID=""
DEFAULT_OWNER_ID=""

# --- YouTube Data API ------------------------------------------------------
# YOUTUBE_API_KEY: Required for auto-fetching YouTube videos, shorts and
# channel metadata. Set this in your environment or secrets.
YOUTUBE_API_KEY="YOUR_YOUTUBE_DATA_API_KEY"
YOUTUBE_DATA_API_KEY="YOUR_YOUTUBE_DATA_API_KEY"

# --- Supabase Edge Functions ---------------------------------------------
# If you deploy the Edge Functions, set their base URL (project ref only).
# Example: https://<project-ref>.supabase.co
VITE_SUPABASE_FUNCTIONS_URL="https://YOUR_PROJECT.supabase.co"

# --- Razorpay (payments) ---------------------------------------------------
# RAZORPAY_KEY_ID is public (it is sent to the browser to open Checkout).
# RAZORPAY_KEY_SECRET is a SERVER-ONLY secret: it signs the order request and
# verifies the payment signature. Never expose it to the client bundle.
# Test keys come from https://dashboard.razorpay.com → Settings → API Keys.
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# NOTE: keys are loaded in this order (first match wins):
#   1. real environment variables (Vercel / Cloud Run / shell)
#   2. .env                (git-ignored — your real secrets)
#   3. .env.development    (committed — Razorpay TEST keys only)
# Verify everything with:  npm run check:razorpay

# --- Razorpay webhook ------------------------------------------------------
# A secret YOU choose; it must match the one entered in the Razorpay dashboard
# (Settings -> Webhooks). Used to verify the X-Razorpay-Signature header.
# Endpoint: <your-domain>/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# --- API resilience (optional) ---------------------------------------------
# Budgets used by server/dbGuard.ts. Defaults are tuned so the API always
# answers JSON before a 10s serverless invocation limit turns a slow database
# into an un-parseable HTML error page.
#   DB_TIMEOUT_MS         single database round-trip           (default 6000)
#   DB_LOOKUP_TIMEOUT_MS  owner/notification lookups           (default 4000)
#   API_REQUEST_TIMEOUT_MS whole request before a JSON 504     (default 9000)
DB_TIMEOUT_MS=""
DB_LOOKUP_TIMEOUT_MS=""
API_REQUEST_TIMEOUT_MS=""

# --- Diagnostics -----------------------------------------------------------
# GET /api/health          configuration + readiness summary
# GET /api/health?deep=1   also round-trips the bookings/profiles tables
# Use it first whenever a customer reports a failed booking.
