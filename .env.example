# ============================================================================
# Nexora Salon OS — Environment Variables
# ============================================================================

# --- Gemini AI -------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase (used by the client) -----------------------------------------
# These are safe to expose in the browser (Supabase anon key).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --- Supabase (server-side only) -------------------------------------------
# Do NOT expose the service role key to the browser.
# Used by server.ts (Express) and by Supabase Edge Functions.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Server-only: fallback owner (auth user id) used when a booking is created
# by an anonymous guest and the salon's owner id can't be resolved.
SUPABASE_DEMO_OWNER_ID=""
DEFAULT_OWNER_ID=""

# --- YouTube Data API ------------------------------------------------------
# YOUTUBE_API_KEY: Required for auto-fetching YouTube videos, shorts and
# channel metadata. Set this in your environment or secrets.
YOUTUBE_API_KEY="YOUR_YOUTUBE_DATA_API_KEY"
YOUTUBE_DATA_API_KEY="YOUR_YOUTUBE_DATA_API_KEY"

# --- Supabase Edge Functions ---------------------------------------------
# If you deploy the Edge Functions, set their base URL (project ref only).
# Example: https://<project-ref>.supabase.co
VITE_SUPABASE_FUNCTIONS_URL="https://YOUR_PROJECT.supabase.co"
